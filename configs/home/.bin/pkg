#! /bin/bash

HELP="usage: pkg [COMMAND] [PACKAGES]

commands:
    help             (h)   display this help message and exit.
    search           (s)   search for a single package.
    install          (i)   install new packages.
    flatpak-install  (fi)  install flatpak packages.
    update           (u)   update installed packages.
    remove           (r)   remove provided packages.
    flatpak-remove   (fr)  remove flatpak packages.
    clean            (c)   remove orphan packages.
    version          (v)   check package version.
";


case "$1" in
    "help" | "h")
        echo "$HELP";
    ;;

    # no arg commands.
    "update" | "u")
        sudo apt-get update -y;
        sudo apt-get dist-upgrade -y;
        sudo flatpak update -y 2>/dev/null 2>/dev/null;
    ;;

    "clean" | "c")
        sudo apt-get autoremove --purge;
        sudo flatpak uninstall --unused;
    ;;

    # single-arg commands.
    "search" | "s")
        PKG=$2;
        apt-cache search "$PKG";
    ;;

    "version" | "v")
        PKG="$2";
        apt policy "$PKG";
    ;;

    # multi-arg commands.
    "install" | "i")
        sudo apt-get install -y "${@:2}";
    ;;

    "flatpak-install" | "fi")
        sudo flatpak install flathub -y "${@:2}";
    ;;

    "remove" | "r")
        sudo apt-get remove "${@:2}";
    ;;

    "flatpak-remove" | "fr")
        sudo flatpak uninstall --delete-data "${@:2}";
    ;;

    *)
        echo "$HELP";
    ;;
esac
